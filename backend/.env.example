SPRING_PROFILES_ACTIVE=postgres,cloudinary,prod

MYGALLERY_DB_URL=jdbc:postgresql://host.example:5432/database?sslmode=require
MYGALLERY_DB_USERNAME=replace_me
MYGALLERY_DB_PASSWORD=replace_me
MYGALLERY_DB_POOL_MAX_SIZE=5
MYGALLERY_DB_POOL_MIN_IDLE=0
MYGALLERY_DB_CONNECTION_TIMEOUT=10000
MYGALLERY_DB_VALIDATION_TIMEOUT=5000
MYGALLERY_MAX_HTTP_REQUEST_HEADER_SIZE=16KB
MYGALLERY_SERVER_CONNECTION_TIMEOUT=10s

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_UPLOAD_PUBLIC_ID_PREFIX=mygallery/originals
CLOUDINARY_UPLOAD_MAX_BYTES=52428800
CLOUDINARY_UPLOAD_SIGNATURE_TTL_SECONDS=120
CLOUDINARY_UPLOAD_ALLOWED_FORMATS=jpg,jpeg,png,webp,heic,heif

ADMIN_USERNAME=
ADMIN_PASSWORD_BCRYPT_HASH=
ADMIN_SESSION_ABSOLUTE_TIMEOUT=8h

CORS_ALLOWED_ORIGINS=

SESSION_COOKIE_NAME=__Host-mygallery-session
SESSION_COOKIE_SECURE=true
